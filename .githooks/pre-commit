#!/bin/bash
# ─────────────────────────────────────────────────────────────────────
# commit の直前に「発行元が分かる語・鍵・個人が特定できるもの」が
# 混じっていないかを調べる見張り。
#
# 【なぜ要るか】いちど commit すると、その中身は git の履歴に残り、
#   消すにはリポジトリごと作り直すしかない（2026-08-04 に実際に2回実施）。
#   ところが、この置き場の作業リポ16本のうち14本には commit 前の見張りが
#   1つも無く、残る2本も匂わせ・鍵の検査を呼んでいなかった（2026-09-18 実測）。
#   いちばん安く止められるのは「commit の前」なので、ここで1回だけ調べる。
#
# 【どこを調べるか】**commit に入る版（指標＝index）だけ**を調べる。
#   作業フォルダは見ない。「壊れた版を指標に入れる → 作業フォルダだけ直す
#   → commit」で素通りする穴が 2026-09-17 に実測で見つかっているため。
#
# 【止める・止めない】🔴 が1件でもあれば止める。🟡 は画面に出すだけで通す。
#   （検査の作り物に 🟡 の語が混ざりやすく、毎回止まると見張りごと外される）
#   **検査が最後まで走らなかったときも止める**（2026-09-19 追加）。
#   「確かめられなかった」を「見つからなかった」とも「見つかった」とも言わない。
#
# 【逃げ道】  ALLOW_LEAK=1 git commit -m "…"
# 【置き場】  各パソコンで1回だけ： git config core.hooksPath .githooks
#            （digikar-doc-maker だけは元からの置き場に合わせて githooks）
# 【リポごとの検査】同じ置き場に pre-commit-local があれば、最後にそれを呼ぶ。
#   このファイル自体は**全リポジトリで1バイトも違わない**。リポごとの事情は
#   pre-commit-local に書く（書き分けると、直しが片方だけになる）。
# ─────────────────────────────────────────────────────────────────────

HOOK_DIR="$(dirname "$0")"
LEAK="$HOME/.claude/scripts/check-leak.sh"

# リポジトリごとの検査（あれば）を呼んで終わる。
run_local() {
  if [ -x "$HOOK_DIR/pre-commit-local" ]; then
    "$HOOK_DIR/pre-commit-local"
    exit $?
  fi
  exit 0
}

# 【逃げ道】飛ばしたことは必ず画面に出す（黙って素通りさせない）。
if [ "${ALLOW_LEAK:-0}" = "1" ]; then
  echo "⚠️ ALLOW_LEAK=1 のため、匂わせ・鍵の検査を飛ばしました。" >&2
  run_local
fi

# 【検査台が無いパソコンでは止める】（2026-09-22 に「通す」から変更）
#   それまでは理由を1行出して通していた。だが「確かめられなかった」を「問題なし」と同じ返事に
#   するのは、このフック自身が冒頭で禁じている型そのものだった（検査が完走しなかったときは止める）。
#   設定を取り込む前のパソコンでは、院名・役職・鍵が入ったままの commit がそのまま通っていた（実測）。
#   git の履歴に入ると、消すにはリポジトリを作り直すしかない（過去に2回実施）。
#   ★作業が詰まらないように、上の逃げ道（ALLOW_LEAK=1）はそのまま残してある。
if [ ! -f "$LEAK" ]; then
  echo "❌ 検査台が見つからないので、匂わせ・鍵を確かめられません。止めます。" >&2
  echo "   探した場所： $LEAK" >&2
  echo "   設定を取り込む：  cd ~/.claude && git pull" >&2
  echo "   どうしても通すなら： ALLOW_LEAK=1 git commit -m \"…\"" >&2
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$ROOT" ]; then cd "$ROOT" || exit 1; fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/precommit-leak.XXXXXX")" || {
  echo "❌ 一時の置き場を作れませんでした。確かめられないので止めます。" >&2
  exit 1
}
trap 'rm -rf "$WORK"' EXIT
STAGE="$WORK/stage"
mkdir -p "$STAGE"

# 【要】commit に入る版を取り出す。改名（R）も必ず入れる。改名しながら中身も
#   直した変更が、ACM だけでは丸ごと素通りするため（2026-09-18 に塞いだ）。
# 【要】commit に入る版を取り出す。-z を付けるのは、日本語のファイル名が
#   引用符つきの別名（\346\227\245…）に化けて取り出せなくなるのを防ぐため。
n=0
while IFS= read -r -d '' p; do
  dst="$STAGE/$p"
  mkdir -p "$(dirname "$dst")" || exit 1
  if git show ":$p" > "$dst" 2>/dev/null; then
    n=$((n + 1))
  else
    rm -f "$dst"
    echo "❌ 「${p}」の『commit に入る版』を取り出せませんでした。確かめられないので止めます。" >&2
    exit 1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$n" -eq 0 ]; then
  run_local
fi

# 「確認ずみの例外」の控えも、commit に入る版を持ってくる。
# これが無いと、すでに人が確かめて許した行まで毎回 🔴 になって止まる。
if [ ! -f "$STAGE/.leak-allow" ]; then
  git show ":.leak-allow" > "$STAGE/.leak-allow" 2>/dev/null || rm -f "$STAGE/.leak-allow"
fi

# 【要】終了コードは単独で取る。`&&` にも `| tail` にも繋がない。
#   繋いだせいで 🔴 を1件そのまま push した実害がある（パイプは最後の命令の
#   結果を返すので、検査が落ちたことが消えてしまう）。
OUT="$WORK/out.txt"
bash "$LEAK" "$STAGE" > "$OUT" 2>&1
rc=$?

# 【要】**最後まで走ったか**を、終了コードと「完走の印」の両方で確かめる（2026-09-19 新設）。
#   検査台が途中で死ぬと 🔴 の行が1つも出ない。それを「見つからなかった」と読むと、
#   混ざったまま commit が通る。実際に `LANG=ja_JP.UTF-8` が付いているだけで
#   途中死する不具合があり、しかもそのときの終了コードは 1＝「🔴 あり」と同じ値だった。
#   いまは途中死が 3 で返るが、**終了コードだけに頼らない**（外から kill された・
#   古い検査台が入っている等では 3 にならない）。印が無ければ、黙って🔴扱いにもしない。
DONE_MARK="══ 検査ここまで（完走） ══"
if [ "$rc" -eq 3 ] || ! grep -qF "$DONE_MARK" "$OUT"; then
  echo "❌ 匂わせ・鍵の検査が**最後まで走りませんでした**（終了コード ${rc}）。" >&2
  echo "   確かめられないので止めます。🔴 が見つかったわけでも、無かったわけでもありません。" >&2
  echo "   手で確かめてください： env -u LANG -u LC_ALL -u LC_CTYPE bash \"$LEAK\" ." >&2
  cat "$OUT" >&2
  echo "" >&2
  echo "   どうしても通すなら： ALLOW_LEAK=1 git commit -m \"…\"" >&2
  exit 1
fi

if [ "$rc" -eq 0 ]; then
  # 見つかった行だけを出す。まとめの行（「… 0 件」）まで拾うと、
  # 何も無い commit でも毎回 🟡 が出て、すぐに読み飛ばされるようになる。
  if grep -q '^🟡 \[' "$OUT"; then
    echo "🟡 気になる語が見つかりました（止めません。中身を確かめてください）" >&2
    grep '^🟡 \[' "$OUT" >&2
  fi
  run_local
fi

if [ "$rc" -eq 2 ]; then
  echo "❌ 検査台を動かせませんでした（終了コード 2）。確かめられないので止めます。" >&2
else
  echo "❌ commit に入る中身に、公開できないもの（🔴）が見つかりました。" >&2
fi
cat "$OUT" >&2
echo "" >&2
echo "   直してから commit してください（調べたのは commit に入る版です。" >&2
echo "   作業フォルダだけ直しても通りません。git add をやり直してください）。" >&2
echo "   どうしても通すなら： ALLOW_LEAK=1 git commit -m \"…\"" >&2
exit 1
