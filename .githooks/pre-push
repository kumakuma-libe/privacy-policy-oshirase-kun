#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# push の直前に、このリポジトリの検査（npm test）を**全部**走らせる。
#
# 【なぜ要るか（2026-09-24 の事故）】
#   ある1本で、検査の下限だけ上げて README を直し忘れ、
#   **検査が落ちる状態のまま push できてしまった**。
#   そのリポジトリには commit のときの検査が無く、誰も気づけなかった。
#   数え直したところ、送る手前で検査を通していたのは 19本中 1本だけだった。
#
# 【なぜ commit のときではなく、push の前なのか】
#   commit は1日に何十回もある。そこで毎回待たされると
#   「今回だけ飛ばす」を使いたくなり、**見張りを置かない運用そのものに戻る**。
#   push は外へ出ていく一度きりなので、ここで必ず全部を通す。
#   commit のときの検査（.githooks/pre-commit・匂わせと鍵）はこれまでどおり。
#
# 【このファイルは全リポジトリで1バイトも違わない】
#   リポジトリごとの事情を書くと、直しが片方だけになる（＝片肺）。
#   事情があるときは pre-commit-local と同じ流儀で別ファイルに分ける。
#
# 【置き場】各パソコンで1回だけ： git config core.hooksPath .githooks
#   （Mac では chmod +x .githooks/pre-push も1回）
#
# 【落ちたとき】検査を直してから push すること。
#   ここには「押し通すやり方」を書かない。書くと、そこが常用の近道になる。
# ─────────────────────────────────────────────────────────────────────

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$ROOT" ]; then
  cd "$ROOT" || exit 1
fi

# ---------------------------------------------------------------------------
# 検査の走らせ役を探す。**見つからない・動かせないときは、黙って通さない。**
#
# ⚠ 2026-09-24 の初版は「npm が無ければ exit 0（通す）」だった。ところが同じ
#   ファイルの中で「package.json が無ければ exit 1（止める）」としており、
#   **判断が割れていた**。npm の入っていないパソコンでは、全リポで送る手前の
#   検査が黙って消える。「調べられないのに合格」はこの置き場で何度も踏んだ型なので、
#   どちらも**止める**にそろえる。
#
# ⚠ Python だけのリポジトリ（走らせ役が run_tests.py）もこの1本で守る。
#   リポジトリごとに書き分けると、直しが片方だけになる（＝片肺）。
# ---------------------------------------------------------------------------
if [ -f package.json ]; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "❌ npm が見つかりません。検査を走らせられないので push を止めます。" >&2
    echo "   npm の入ったパソコンから push するか、npm を入れてください。" >&2
    exit 1
  fi
  echo "🔍 push 前の検査（npm test）を走らせています。終わるまでお待ちください…" >&2
  npm test --silent
  rc=$?
elif [ -f run_tests.py ]; then
  # Windows では `py -3` が正。探す順番は test/py-cmd.js と同じ流儀にそろえる。
  if command -v python3 >/dev/null 2>&1; then PY_CMD="python3"
  elif command -v py >/dev/null 2>&1; then PY_CMD="py -3"
  else
    echo "❌ Python 3 が見つかりません。検査を走らせられないので push を止めます。" >&2
    exit 1
  fi
  echo "🔍 push 前の検査（$PY_CMD run_tests.py）を走らせています。終わるまでお待ちください…" >&2
  $PY_CMD run_tests.py
  rc=$?
else
  echo "❌ 検査の走らせ役（package.json / run_tests.py）が見つかりません。push を止めます。" >&2
  echo "   何も判定していないので、通すわけにはいきません。" >&2
  exit 1
fi

if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "❌ 検査が通りませんでした（終了コード ${rc}）。push を止めます。" >&2
  echo "   上に出ている落ちた検査を直してから、もう一度 push してください。" >&2
  exit 1
fi

echo "✅ 全部の検査に通りました。push します。" >&2
exit 0
